{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "NestAPI Documentation",
  "colors": {
    "primary": "#0D9373",
    "light": "#07C983",
    "dark": "#0D9373"
  },
  "logo": {
    "light": "/images/logo-light.svg",
    "dark": "/images/logo-dark.svg"
  },
  "favicon": "/images/favicon.svg",
  "navigation": {
    "groups": [
      {
        "group": "Getting Started",
        "pages": ["introduction", "authentication", "quickstart"]
      },
      {
        "group": "Guides",
        "pages": [
          "guides/nesting-workflow",
          "guides/webhooks",
          "guides/geometry-types",
          "guides/quote-nesting",
          "guides/1d-nesting"
        ]
      },
      {
        "group": "Concepts",
        "pages": [
          "concepts/parts-and-sheets",
          "concepts/simple-geometry",
          "concepts/nesting-settings",
          "concepts/common-cutting",
          "concepts/export-types"
        ]
      },
      {
        "group": "Account",
        "pages": ["account/api-keys", "account/fairness", "account/profile"]
      },
      {
        "group": "API Reference",
        "pages": [
          {
            "group": "Nesting",
            "openapi": "openapi.json",
            "pages": [
              "POST /v1/nesting",
              "POST /v1/nesting/geometry",
              "POST /v1/nesting/parametric",
              "POST /v1/nesting/mynesting",
              "POST /v1/nesting/quotenesting",
              "POST /v1/nesting/geometryquotenesting",
              "POST /v1/nesting/1D"
            ]
          },
          {
            "group": "Run & track",
            "openapi": "openapi.json",
            "pages": [
              "POST /v1/nesting/delayedstart",
              "POST /v1/nesting/continue",
              "GET /v1/nesting/status",
              "GET /v1/nesting/successes",
              "GET /v1/nesting/failures"
            ]
          },
          {
            "group": "Results & exports",
            "openapi": "openapi.json",
            "pages": [
              "POST /v1/nesting/result/",
              "POST /v1/nesting/1D/result",
              "GET /v1/nesting/render/",
              "GET /v1/nesting/export",
              "GET /v1/nesting/exportquotenest",
              "GET /v1/nesting/export/cached"
            ]
          },
          {
            "group": "Account & keys",
            "openapi": "openapi.json",
            "pages": [
              "GET /v1/user/profile",
              "GET /v1/status",
              "GET /v1/auth/validate",
              "GET /v1/apiKey/validUntil",
              "GET /admin/keys",
              "POST /admin/keys",
              "POST /admin/keys/{ApiKeyId}/regenerate",
              "PATCH /admin/keys/{ApiKeyId}/type",
              "DELETE /admin/keys/{ApiKeyId}",
              "GET /apikeys/{KeyId}/origins",
              "POST /apikeys/{KeyId}/origins",
              "DELETE /apikeys/{KeyId}/origins"
            ]
          },
          {
            "group": "Fairness",
            "openapi": "openapi.json",
            "pages": [
              "GET /admin/fairness/config",
              "PATCH /admin/fairness/config",
              "PATCH /admin/keys/{ApiKeyId}/weight",
              "GET /usage/fairness"
            ]
          },
          {
            "group": "Service",
            "openapi": "openapi.json",
            "pages": [
              "GET /public/alive"
            ]
          }
        ]
      }
